# ==============================================================================
# VertexERP AI V2 - Production Environment Configuration
# ==============================================================================

# Application Metadata & Environment
APP_NAME=VertexERP-AI-V2
APP_ENV=development # Options: development, staging, production
APP_VERSION=2.0.0
DEBUG=false

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Security & CORS
# In production, specify exact allowed origins (e.g., https://app.vertexerp.io)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","app.vertexerp.local"]

# JWT Authentication (RS256 Private/Public Keys or Secret)
# In production, use 2048-bit RS256 RSA keys.
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_chars_long!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
INTEGRATION_SIGNING_SECRET=REPLACE_WITH_UNIQUE_INTEGRATION_SIGNING_SECRET

# Primary Relational Persistence (PostgreSQL 16)
# Note: SQLite is strictly prohibited across all environments
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=vertexerp_v2
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Distributed Cache & Message Broker (Redis 7.2)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_SOCKET_TIMEOUT=5.0

# Structured Logging & Telemetry
LOG_LEVEL=INFO # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_JSON_FORMAT=true

# AI Provider Gateway (Optional in Foundation)
AI_DEFAULT_PROVIDER=openai # Options: openai, gemini, claude, local
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Object Storage (S3 / MinIO)
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=vertexerp-vault
STORAGE_USE_SSL=false
