# ==============================================================================
# VertexERP AI V2 - Development Environment Configuration
# ==============================================================================

# Core Application
APP_NAME=VertexERP-AI-V2
APP_ENV=development
APP_VERSION=2.0.0
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Cryptography (Development defaults)
JWT_SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_chars_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173"]
ALLOWED_HOSTS=*

# PostgreSQL Database (Development)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=vertexerp_v2
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Redis In-Memory Cache & Broker (Development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# S3 Object Storage / MinIO (Development)
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=vertexerp-dev-storage
STORAGE_SECURE=false

# AI Gateway & Copilot
AI_DEFAULT_PROVIDER=mock
AI_GATEWAY_API_KEY=mock-dev-key
AI_DEFAULT_MODEL=mock-model-v1
AI_EMBEDDING_MODEL=mock-embedding-v1
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096

# Observability & Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
ENABLE_TELEMETRY=true

# Rate Limiting (Permissive in Dev)
RATE_LIMIT_AUTH_PER_MINUTE=500
RATE_LIMIT_AI_PER_MINUTE=300
RATE_LIMIT_DEFAULT_PER_MINUTE=1000
