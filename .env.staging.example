# ==============================================================================
# VertexERP AI V2 - Staging Environment Configuration
# ==============================================================================

# Core Application
APP_NAME=VertexERP-AI-V2
APP_ENV=staging
APP_VERSION=2.0.0
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Security & Cryptography (Staging Strong Keys)
# Generate with: python scripts/generate_secrets.py
JWT_SECRET_KEY=REPLACE_WITH_SECURE_STAGING_JWT_SECRET_KEY_MIN_32_BYTES
JWT_ALGORITHM=HS256
INTEGRATION_SIGNING_SECRET=REPLACE_WITH_SECURE_STAGING_INTEGRATION_SIGNING_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOWED_ORIGINS=["https://staging.vertexerp.io","https://staging-api.vertexerp.io"]
ALLOWED_HOSTS=["staging.vertexerp.io","staging-api.vertexerp.io","api","proxy","localhost"]

# PostgreSQL Database (Staging)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=vertex_staging_user
DATABASE_PASSWORD=REPLACE_WITH_SECURE_STAGING_DATABASE_PASSWORD
DATABASE_NAME=vertexerp_staging
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Redis In-Memory Cache & Broker (Staging)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=100

# S3 Object Storage / MinIO (Staging)
STORAGE_PUBLIC_ENDPOINT_URL=http://minio:9000
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=REPLACE_WITH_STAGING_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_SECURE_STAGING_STORAGE_SECRET_KEY
STORAGE_BUCKET_NAME=vertexerp-staging-storage

# AI Gateway & Copilot
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_STAGING_OPENAI_API_KEY
AI_DEFAULT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096

# Observability & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_TELEMETRY=true

# Rate Limiting (Staging Enforced)
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=60
RATE_LIMIT_DEFAULT_PER_MINUTE=300
