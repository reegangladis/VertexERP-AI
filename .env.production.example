# ==============================================================================
# VertexERP AI V2 - Production Environment Configuration
# ==============================================================================
# IMPORTANT: All passwords and secrets MUST be uniquely generated before deployment.
# Run `python scripts/generate_secrets.py` to produce strong cryptographic tokens.

# Core Application
APP_NAME=VertexERP-AI-V2
APP_ENV=production
APP_VERSION=2.0.0
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Security & Cryptography (Production Zero-Trust Keys)
# MUST BE >= 32 characters, unique, and strictly kept in secrets manager.
JWT_SECRET_KEY=REPLACE_WITH_SECURE_PRODUCTION_JWT_SECRET_KEY_MIN_32_BYTES_RANDOM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
INTEGRATION_SIGNING_SECRET=REPLACE_WITH_UNIQUE_INTEGRATION_SIGNING_SECRET
ALLOWED_ORIGINS=["https://app.vertexerp.io","https://admin.vertexerp.io"]
ALLOWED_HOSTS=["app.vertexerp.io","api.vertexerp.io","admin.vertexerp.io","api","proxy"]

# PostgreSQL Database (Production)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=vertex_prod_app
DATABASE_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_DATABASE_PASSWORD_SECURE_9988!
DATABASE_NAME=vertexerp_production
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=50
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Redis Distributed Cache & Broker (Production)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_AUTH_PASSWORD_OR_LEAVE_EMPTY_IF_INTERNAL
REDIS_MAX_CONNECTIONS=200

# S3 Object Storage / AWS S3 / MinIO (Production)
STORAGE_PUBLIC_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
STORAGE_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
STORAGE_ACCESS_KEY=REPLACE_WITH_PRODUCTION_S3_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_PRODUCTION_S3_SECRET_KEY
STORAGE_BUCKET_NAME=vertexerp-production-documents

# AI Gateway & Copilot
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_SECURE_OPENAI_OR_ANTHROPIC_KEY
AI_DEFAULT_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-large
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096

# Observability & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_TELEMETRY=true

# Rate Limiting (Strict Production Sliding Window)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=120
